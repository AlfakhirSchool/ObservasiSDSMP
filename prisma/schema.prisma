generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  passwordHash String?
  email        String?  @unique
  name         String?
  role         Role     @default(INTERVIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Candidate {
  id                  String            @id @default(cuid())
  name                String
  level               Level
  status              Status            @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  selectedInterviewer String?
  room                String?
  parentEmail         String?
  studentEmail        String?
  parentPhone         String?
  correctedName       String?
  academicYear        String?
  /// Observasi Al-Qur'an (tes baca 2 halaman): A/B/C. Null = belum dinilai. Lihat src/lib/quran.ts.
  quranNilai          String?
  quranCatatan        String?
  quranDinilaiOleh    String?
  gelombang           Int               @default(1)
  nim                 String?
  originSchool        String?
  /// Isian raport SD dari guru (JSON: nilai 23 indikator + catatan per aspek), dapat disimpan dan diubah kapan saja.
  /// Lihat src/lib/raport-sd.ts.
  sdRaport            String?
  aiSummary           AiSummary?
  academicTestResult  AcademicTestResult?
  academicResponses   AcademicResponse[]
  formAnswers         FormAnswer[]
  notes               InterviewerNote[]

  @@index([level, academicYear])
  @@index([selectedInterviewer])
  @@index([createdAt])
}

model AcademicQuestion {
  id            String             @id @default(cuid())
  text          String
  subject       String
  imageUrl      String?
  options       String             // JSON array
  correctAnswer String
  order         Int                @default(0)
  responses     AcademicResponse[]
}

model AcademicResponse {
  id          String           @id @default(cuid())
  candidateId String
  questionId  String
  answer      String
  isCorrect   Boolean
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question    AcademicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, questionId])
}

model AcademicTestResult {
  id            String    @id @default(cuid())
  candidateId   String    @unique
  totalScore    Float
  subjectScores String    // JSON string breakdown
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model FormQuestion {
  id        String       @id @default(cuid())
  text      String
  type      String
  category  String
  level     Level?
  order     Int          @default(0)
  options   String?
  isSystem  Boolean      @default(false)
  /// Judul bagian/langkah di formulir publik. Kosong = dikumpulkan di bagian umum.
  section   String?
  /// false = boleh dikosongkan oleh pengisi.
  required  Boolean      @default(true)
  /// Petunjuk singkat di bawah pertanyaan (mis. contoh pengisian).
  hint      String?
  /// Tampilkan hanya bila jawaban pertanyaan `showIfId` sama dengan `showIfValue` (tanpa relasi; id yang hilang = selalu tampil).
  showIfId    String?
  showIfValue String?
  createdAt DateTime     @default(now())
  answers   FormAnswer[]
}

model FormAnswer {
  id          String       @id @default(cuid())
  candidateId String
  questionId  String
  value       String
  createdAt   DateTime     @default(now())
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question    FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, questionId])
}

model InterviewerNote {
  id                 String    @id @default(cuid())
  candidateId        String
  interviewerEmail   String
  interviewerName    String
  observation        String
  academicAssessment String
  familySupport      String
  characterNotes     String
  recommendation     String
  isLocked           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  otherNotes         String?
  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Satu catatan per siswa: mencegah catatan ganda saat dua permintaan masuk bersamaan.
  @@unique([candidateId])
}

model AiSummary {
  id          String    @id @default(cuid())
  candidateId String    @unique
  summary     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  ADMIN_SD
  ADMIN_SMP
  INTERVIEWER
}

enum Level {
  SD
  SMP
}

enum Status {
  PENDING
  RESPONSE_RECEIVED
  REVIEWED
  COMPLETED
}

/// Pembatasan laju (login, AI, form publik) yang tahan multi-instance karena disimpan di database.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Status timer wawancara (8 menit, maks. 10) tiap pewawancara, disinkronkan dari browser agar admin bisa memantau.
/// Hanya informasi; tanpa relasi ke Candidate/User agar tidak menghalangi penghapusan data. Baris basi dibuang saat sinkron.
model InterviewTimer {
  interviewerId   String
  candidateId     String
  interviewerName String
  candidateName   String
  level           Level
  /// Awal segmen berjalan (jam server); null = dijeda/berhenti.
  startedAt       DateTime?
  /// Waktu berjalan sampai startedAt (atau total saat dijeda), dalam ms.
  elapsedMs       Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@id([interviewerId, candidateId])
  @@index([updatedAt])
}

/// Riwayat aktivitas (audit log): siapa melakukan apa, kapan, pada siapa/apa. Jangan simpan password atau NIM.
model ActivityLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// Null untuk pengunjung publik atau percobaan login dengan username tak dikenal.
  actorId     String?
  actorName   String
  actorRole   String
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  detail      String?
  ip          String?

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

/// Gambar tanda tangan/stempel raport. Disimpan di DB (bukan public/) karena repo publik; hanya admin yang bisa memuatnya.
model RaportAsset {
  key       String   @id
  mime      String
  data      String
  updatedAt DateTime @updatedAt
}
